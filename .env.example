# Cliente e servidor (chave pública, sujeita à RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor: ignora a RLS. Nunca prefixar com NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação, usada no link de redefinição de senha.
NEXT_PUBLIC_SITE_URL=

# Site key do Cloudflare Turnstile (pública). A secret correspondente é cadastrada
# no painel do Supabase, em Authentication > Attack Protection, e não vive aqui.
# Sem este valor, o fluxo administrativo funciona sem captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
